{
	"$description": "Toy design tokens (DTCG format). Edit this file in Figma (export/import via a tokens plugin), then run `npm run build` to regenerate dist/tokens.css. Each token's CSS custom property name lives in $extensions, decoupled from the JSON path, so reorganizing the JSON never renames a var() already used in CSS.",
	"color": {
		"blue": {
			"50": {
				"$value": "#eff6ff",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--blue-50" } }
			},
			"400": {
				"$value": "#60a5fa",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--blue-400" } }
			},
			"500": {
				"$value": "#3b82f6",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--blue-500" } }
			},
			"700": {
				"$value": "#1d4ed8",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--blue-700" } }
			}
		},
		"slate": {
			"50": {
				"$value": "#f8fafc",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--slate-50" } }
			},
			"100": {
				"$value": "#f1f5f9",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--slate-100" } }
			},
			"800": {
				"$value": "#1e293b",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--slate-800" } }
			},
			"900": {
				"$value": "#0f172a",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--slate-900" } }
			}
		}
	},
	"semantic": {
		"light": {
			"brand": {
				"$value": "{color.blue.500}",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--color-brand" } }
			},
			"surface": {
				"$value": "{color.slate.50}",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--color-surface" } }
			},
			"text": {
				"$value": "{color.slate.800}",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--color-text" } }
			}
		},
		"dark": {
			"brand": {
				"$value": "{color.blue.400}",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--color-brand" } }
			},
			"surface": {
				"$value": "{color.slate.900}",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--color-surface" } }
			},
			"text": {
				"$value": "{color.slate.100}",
				"$type": "color",
				"$extensions": { "com.toy.css": { "name": "--color-text" } }
			}
		}
	}
}
